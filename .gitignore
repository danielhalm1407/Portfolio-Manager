# Secrets
.env

# KTS debug logs
orders/logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/

# Data — raw inputs are large and often sensitive
data/raw/

# Local config overrides
config/settings.local.yaml
.claude/settings.local.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Notebook checkpoints
.ipynb_checkpoints/

# Outputs — regenerable, don't commit
outputs/

# Sandbox — local experiments, never committed
sandbox/

# Playwright — session data (login cookies) and MCP artifacts, never commit
.playwright-session/
.playwright-mcp/

# Archived docs — superseded plans, kept locally only
archive/

# CARL — per-session state (dedup signatures, domain toggles) written by
# carl-hook.py into the *nearest* .carl scope, which is now this repo.
# Pure churn; the domain config in .carl/carl.json IS tracked.
.carl/sessions/
